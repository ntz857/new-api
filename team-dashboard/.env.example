# ─── Database ────────────────────────────────────────────────────────────────
# sqlite | mysql | postgres
DB_TYPE=sqlite

# SQLite: path to the new-api database file
DB_DSN=/data/new-api.db

# MySQL example:
# DB_TYPE=mysql
# DB_DSN=user:password@tcp(127.0.0.1:3306)/oneapi?charset=utf8mb4&parseTime=True&loc=Local

# PostgreSQL example:
# DB_TYPE=postgres
# DB_DSN=host=127.0.0.1 user=postgres password=secret dbname=oneapi port=5432 sslmode=disable

# ─── Session ─────────────────────────────────────────────────────────────────
# REQUIRED — change to a long random string in production
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true when serving over HTTPS (enables Secure flag on cookie)
SESSION_SECURE=false

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# Host port exposed by Docker (change this to avoid conflicts, e.g. 9000)
HOST_PORT=8080

# Path to the built frontend dist directory
# Docker default: ./frontend/dist  (set automatically in docker-compose.yml)
# Local dev default: ../frontend/dist
# STATIC_DIR=./frontend/dist

# ─── Volume (docker-compose only) ────────────────────────────────────────────
# Host path that gets mounted to /data inside the container
# DB_PATH=./data
